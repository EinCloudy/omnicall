# Gemini AI Studio
GEMINI_API_KEY=replace-with-a-new-key

# FritzBox IP phone account
SIP_REGISTRAR=fritz.box
SIP_USERNAME=replace-with-fritzbox-username
SIP_PASSWORD=replace-with-fritzbox-password
SIP_CALLER_ID=+49XXXXXXXXXXX

# Internal ARI credential. Generate a long random value.
ARI_USER=hermes
ARI_PASSWORD=replace-with-a-long-random-password

# Optional tuning
# MCP_HOST=0.0.0.0 macht den MCP-Endpunkt im gesamten LAN erreichbar (Standard: 127.0.0.1)
MCP_HOST=127.0.0.1
MCP_PORT=8090
MAX_CONCURRENT_CALLS=2
DEFAULT_CALL_TIMEOUT=45
MAX_CALL_DURATION=900
# false = keine Einwilligungsfrage zur Transkription; das Gespräch startet nach dem
# KI-/Transkriptionshinweis direkt mit dem Anliegen (Standard: true)
CONSENT_QUESTION_ENABLED=true
GEMINI_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_SUMMARY_MODEL=gemini-3.7-flash
GEMINI_SUMMARY_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_VAD_PREFIX_PADDING_MS=100
GEMINI_VAD_SILENCE_MS=650
GEMINI_LIVE_CONNECT_TIMEOUT_SECONDS=15
SIP_DIAL_PREFIX=
